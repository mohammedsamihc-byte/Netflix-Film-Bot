import os
import logging

from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    MessageHandler,
    ContextTypes,
    filters,
)
from telegram.error import TelegramError
from pymongo import MongoClient

# ------------------------------------------------------------------
# CONFIGURAZIONE
# ------------------------------------------------------------------
# Token del bot, tuo ID e stringa di connessione al database si leggono
# dalle variabili d'ambiente (le imposti su Render). NON scriverli qui
# dentro il codice.
BOT_TOKEN = os.environ["BOT_TOKEN"]
ADMIN_ID = int(os.environ["ADMIN_ID"])
MONGO_URI = os.environ["MONGO_URI"]

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# ------------------------------------------------------------------
# CONNESSIONE AL DATABASE (MongoDB Atlas, piano gratuito)
# ------------------------------------------------------------------
client = MongoClient(MONGO_URI)
db = client["filmbot"]
videos = db["videos"]            # {"code": "FILM01", "file_id": "..."}
required_channels = db["required_channels"]  # {"channel_id": "@nomecanale"}


# ------------------------------------------------------------------
# FUNZIONI DI SUPPORTO
# ------------------------------------------------------------------
def get_required_channels():
    return [doc["channel_id"] for doc in required_channels.find()]


async def user_is_subscribed(context: ContextTypes.DEFAULT_TYPE, user_id: int) -> list:
    """Controlla a quali canali/gruppi obbligatori l'utente NON e' iscritto.
    Ritorna la lista dei canali mancanti (vuota se e' a posto ovunque)."""
    missing = []
    for channel in get_required_channels():
        try:
            member = await context.bot.get_chat_member(chat_id=channel, user_id=user_id)
            if member.status in ("left", "kicked"):
                missing.append(channel)
        except TelegramError:
            # Se il bot non riesce a controllare (es. non e' admin nel
            # canale), per sicurezza consideriamo il canale come mancante.
            missing.append(channel)
    return missing


# ------------------------------------------------------------------
# COMANDI UTENTE
# ------------------------------------------------------------------
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Ciao! Scrivimi il codice del film che vuoi ricevere."
    )


async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Un utente scrive un codice: controlliamo l'iscrizione obbligatoria,
    poi se il codice esiste gli mandiamo il video."""
    user_id = update.effective_user.id

    missing = await user_is_subscribed(context, user_id)
    if missing:
        lista = "\n".join(missing)
        await update.message.reply_text(
            "Per usare il bot devi prima iscriverti a:\n"
            f"{lista}\n\nDopo esserti iscritto, riscrivi il codice."
        )
        return

    code = update.message.text.strip().upper()
    result = videos.find_one({"code": code})

    if result:
        await update.message.reply_video(result["file_id"])
    else:
        await update.message.reply_text("Codice non trovato. Controlla e riprova.")


# ------------------------------------------------------------------
# COMANDI ADMIN
# ------------------------------------------------------------------
async def handle_video(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Solo l'admin puo' caricare video. Il codice va scritto nella
    didascalia (caption) del video, es. 'FILM01'."""
    user_id = update.effective_user.id

    if user_id != ADMIN_ID:
        await update.message.reply_text("Non sei autorizzato a caricare video.")
        return

    if not update.message.caption:
        await update.message.reply_text(
            "Manda il video con una didascalia = codice, es. FILM01"
        )
        return

    code = update.message.caption.strip().upper()
    file_id = update.message.video.file_id

    videos.update_one(
        {"code": code},
        {"$set": {"file_id": file_id}},
        upsert=True,
    )

    await update.message.reply_text(f"Video salvato con codice: {code}")


async def add_channel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Comando admin: /addchannel @nomecanale oppure /addchannel -100123456789
    Aggiunge un canale/gruppo all'iscrizione obbligatoria.
    IMPORTANTE: il bot deve essere admin in quel canale/gruppo, altrimenti
    non riesce a controllare chi e' iscritto."""
    user_id = update.effective_user.id

    if user_id != ADMIN_ID:
        await update.message.reply_text("Non sei autorizzato a usare questo comando.")
        return

    if not context.args:
        await update.message.reply_text(
            "Uso: /addchannel @nomecanale  (oppure l'ID del gruppo)"
        )
        return

    channel = context.args[0]
    required_channels.update_one(
        {"channel_id": channel},
        {"$set": {"channel_id": channel}},
        upsert=True,
    )
    await update.message.reply_text(
        f"Aggiunto: ora e' obbligatorio iscriversi a {channel} per usare il bot.\n"
        "Ricorda: devo essere ADMIN in quel canale/gruppo per poter controllare."
    )


async def remove_channel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Comando admin: /removechannel @nomecanale
    Rimuove un canale/gruppo dall'iscrizione obbligatoria."""
    user_id = update.effective_user.id

    if user_id != ADMIN_ID:
        await update.message.reply_text("Non sei autorizzato a usare questo comando.")
        return

    if not context.args:
        await update.message.reply_text("Uso: /removechannel @nomecanale")
        return

    channel = context.args[0]
    required_channels.delete_one({"channel_id": channel})
    await update.message.reply_text(f"Rimosso: {channel} non e' piu' obbligatorio.")


async def list_channels(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Comando admin: /listchannels
    Mostra tutti i canali/gruppi obbligatori attuali."""
    user_id = update.effective_user.id

    if user_id != ADMIN_ID:
        await update.message.reply_text("Non sei autorizzato a usare questo comando.")
        return

    channels = get_required_channels()
    if not channels:
        await update.message.reply_text("Nessun canale/gruppo obbligatorio impostato.")
    else:
        await update.message.reply_text("Obbligatori:\n" + "\n".join(channels))


# ------------------------------------------------------------------
# AVVIO BOT
# ------------------------------------------------------------------
def main():
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("addchannel", add_channel))
    app.add_handler(CommandHandler("removechannel", remove_channel))
    app.add_handler(CommandHandler("listchannels", list_channels))
    app.add_handler(MessageHandler(filters.VIDEO, handle_video))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))

    logger.info("Bot avviato...")
    app.run_polling()


if __name__ == "__main__":
    main()
